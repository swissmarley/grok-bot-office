+// Runs the adapter's page code against a fake Grok Bot renderer shaped like 0.78.1.
+// If an app update renames a store or field, update the fake and NAMES together:
+// these tests say which piece no longer matches.
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { PAGE_INTERNALS, PAGE_OFFICE_INFO, PAGE_OPEN } from "./grokbot-internals.ts";
+
+type Row = Record<string, unknown>;
+
+function fakeApp(opts: { rows?: Row[]; mainId?: string | null; phase?: string; selection?: boolean; selectTakes?: "id" | "object" } = {}) {
+  const calls: string[] = [];
+  let current: string | null = null;
+  const rows = opts.rows ?? [
+    {
+      id: "a",
+      name: "Ada - Chief of Staff",
+      isGroup: false,
+      avatarShape: "blob",
+      avatarColor: "black",
+      avatarPhoto: null,
+      avatarDataUrl: null,
+    },
+    {
+      id: "b",
+      name: "Rui - The Rent Scout",
+      isGroup: false,
+      avatarShape: "heart",
+      avatarColor: "red",
+      avatarPhoto: null,
+      avatarDataUrl: "data:image/png;base64,xx",
+    },
+    { id: "g", name: "Group", isGroup: true },
+  ];
+  const ctx: Record<string, unknown> = {
+    roster: { createAgent: () => calls.push("createAgent"), snapshots: { get: () => ({ agents: { rows } }) } },
+    mainAgent: {
+      ensureDefault: () => calls.push("ensureDefault"),
+      snapshots: { get: () => ({ status: "ready", value: opts.mainId === null ? null : { agentId: opts.mainId ?? "a" } }) },
+    },
+    boxHostPhase: { snapshots: { get: () => opts.phase ?? "settled" } },
+    desktop: { focusWindow: async () => void calls.push("focusWindow") },
+  };
+  if (opts.selection !== false) {
+    ctx.selection = {
+      select: async (arg: unknown) => {
+        calls.push(`select ${JSON.stringify(arg)}`);
+        const takesObject = opts.selectTakes === "object";
+        if (takesObject && typeof arg === "object" && arg) current = (arg as { agentId: string }).agentId;
+        if (!takesObject && typeof arg === "string") current = arg;
+      },
+      readCurrentAgentId: () => current,
+    };
+  }
+  const el = { __reactFiber$x: { memoizedProps: {}, return: { memoizedProps: { value: ctx }, return: null } } };
+  const g = globalThis as Record<string, unknown>;
+  g.document = { querySelector: (sel: string) => (sel.startsWith(".sand-agent-item") ? el : null) };
+  g.navigator = { userAgent: "Mozilla/5.0 (Macintosh) GrokBot/0.78.1 Chrome/148 Electron/42" };
+  return { calls };
+}
+
+// Indirect eval, like CDP's Runtime.evaluate: the page code sees only globals.
+// biome-ignore lint/security/noGlobalEval: page code is evaluated as CDP would
+const pageEval = globalThis.eval;
+const run = <T>(fn: string, ...args: unknown[]): Promise<T> => pageEval(`(${fn})`)(...args);
+
+let saved: Record<string, unknown>;
+beforeEach(() => {
+  const g = globalThis as Record<string, unknown>;
+  saved = { document: g.document, navigator: g.navigator };
+});
+afterEach(() => Object.assign(globalThis, saved));
+
+describe("office info", () => {
+  test("reads avatars, the main Bot and the computer phase", async () => {
+    fakeApp({ phase: "away" });
+    const info = await run<{ computerPhase: string; profiles: unknown[] }>(PAGE_OFFICE_INFO);
+    expect(info.computerPhase).toBe("away");
+    expect(info.profiles).toEqual([
+      { id: "a", avatar: { shape: "blob", color: "black", hasPhoto: false }, main: true },
+      { id: "b", avatar: { shape: "heart", color: "red", hasPhoto: true }, main: false },
+    ]);
+  });
+
+  test("gives null avatars instead of failing when the fields are gone", async () => {
+    fakeApp({ rows: [{ id: "a", name: "Ada", isGroup: false }], mainId: null });
+    const info = await run<{ profiles: unknown[] }>(PAGE_OFFICE_INFO);
+    expect(info.profiles).toEqual([{ id: "a", avatar: null, main: false }]);
+  });
+});
+
+describe("internals check", () => {
+  test("all pieces present", async () => {
+    fakeApp();
+    expect(await run(PAGE_INTERNALS)).toEqual({
+      appVersion: "0.78.1",
+      checks: { roster: true, avatars: true, mainAgent: true, computerPhase: true, selection: true, focusWindow: true },
+    });
+  });
+
+  test("names the piece that changed", async () => {
+    fakeApp({ rows: [{ id: "a", name: "Ada", isGroup: false }], selection: false });
+    const r = await run<{ checks: Record<string, boolean> }>(PAGE_INTERNALS);
+    expect(r.checks.avatars).toBe(false);
+    expect(r.checks.selection).toBe(false);
+    expect(r.checks.roster).toBe(true);
+  });
+});
+
+describe("open", () => {
+  test.each(["id", "object"] as const)("selects the conversation (select takes %s) and focuses the window", async (selectTakes) => {
+    const { calls } = fakeApp({ selectTakes });
+    expect(await run(PAGE_OPEN, "b")).toEqual({ selected: true, focused: true });
+    expect(calls.at(-1)).toBe("focusWindow");
+  });
+
+  test("never creates, edits or answers anything", async () => {
+    const { calls } = fakeApp();
+    await run(PAGE_OFFICE_INFO);
+    await run(PAGE_INTERNALS);
+    expect(calls).toEqual([]);
+  });
+});
