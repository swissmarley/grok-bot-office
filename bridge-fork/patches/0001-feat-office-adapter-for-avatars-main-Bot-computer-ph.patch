+  if (f && f.code) return f.code + (e.message && e.message !== f.code ? ": " + e.message : "");
+  return String((e && e.message) || e);
+}`;
+var PAGE_AWAKE = `async (id, fn) => {
+  for (let i = 0; ; i++) {
+    await Promise.resolve(window.desktop?.main?.signalBoxIntent?.({ agentId: id, intent: "composer_focus" })).catch(() => {});
+    try { return await fn(); } catch (e) {
+      const f = e && e.failure;
+      // Away-park lasts until the Grok Bot window is in front again, so retrying won't help.
+      if (i >= 8 || !(f && f.code === "sand-box-blocked") || f.sandBoxBlockReason === "SAND_AWAY_PARK") throw e;
+      await new Promise((s) => setTimeout(s, 1500));
+    }
+  }
+}`;
+
+// src/adapter/grokbot-internals.ts
+var NAMES = {
+  roster: {
+    store: "roster",
+    method: "createAgent",
+    avatarShape: "avatarShape",
+    avatarColor: "avatarColor",
+    photo: ["avatarPhoto", "avatarDataUrl"]
+  },
+  mainAgent: { store: "mainAgent", method: "ensureDefault" },
+  selection: { store: "selection", method: "select", current: "readCurrentAgentId" },
+  desktop: { store: "desktop", method: "focusWindow" }
+};
+var N = JSON.stringify(NAMES);
+var STORES = `
+  const NAMES = ${N};
+  const roster = ${store(NAMES.roster.store, NAMES.roster.method)};
+  const mainAgent = ${store(NAMES.mainAgent.store, NAMES.mainAgent.method)};
+  const selection = ${store(NAMES.selection.store, NAMES.selection.method)};
+  const desktop = ${store(NAMES.desktop.store, NAMES.desktop.method)};
+  const mainId = () => {
+    try { const s = mainAgent && mainAgent.snapshots.get(); return (s && s.value && s.value.agentId) || null; } catch { return null; }
+  };
+  const phase = () => { try { const p = ${BOX_PHASE}; return typeof p === "string" ? p : null; } catch { return null; } };
+`;
+var PAGE_OFFICE_INFO = `async () => {${STORES}
+  if (!roster) throw new Error("Couldn't reach Grok Bot's Bot list.");
+  const f = NAMES.roster;
+  const main = mainId();
+  const rows = roster.snapshots.get().agents.rows.filter((r) => !r.isGroup);
+  return {
+    computerPhase: phase(),
+    profiles: rows.map((r) => ({
+      id: r.id,
+      avatar: f.avatarShape in r || f.avatarColor in r
+        ? { shape: typeof r[f.avatarShape] === "string" ? r[f.avatarShape] : null,
+            color: typeof r[f.avatarColor] === "string" ? r[f.avatarColor] : null,
+            hasPhoto: f.photo.some((k) => !!r[k]) }
+        : null,
+      main: !!main && r.id === main,
+    })),
+  };
+}`;
+var PAGE_INTERNALS = `async () => {${STORES}
+  const rows = roster ? roster.snapshots.get().agents.rows.filter((r) => !r.isGroup) : [];
+  const m = /GrokBot\\/([\\d.]+)/.exec(navigator.userAgent);
+  return {
+    appVersion: m ? m[1] : null,
+    checks: {
+      roster: !!roster,
+      avatars: rows.length > 0 && rows.every((r) => typeof r[NAMES.roster.avatarShape] === "string"),
+      mainAgent: !!mainId(),
+      computerPhase: phase() !== null,
+      selection: !!selection && typeof selection[NAMES.selection.current] === "function",
+      focusWindow: !!desktop && typeof desktop[NAMES.desktop.method] === "function",
+    },
+  };
+}`;
+var PAGE_OPEN = `async (id) => {${STORES}
+  if (!selection) throw new Error("Couldn't reach Grok Bot's conversation selection. This app version may have changed.");
+  const current = () => { try { return selection[NAMES.selection.current](); } catch { return null; } };
+  const pause = (ms) => new Promise((r) => setTimeout(r, ms));
+  // The argument shape isn't documented: try the id, then { agentId }.
+  for (const arg of [id, { agentId: id }]) {
+    try { await selection[NAMES.selection.method](arg); } catch {}
+    for (let i = 0; i < 10 && current() !== id; i++) await pause(50);
+    if (current() === id) break;
+  }
+  const selected = current() === id;
+  let focused = false;
+  if (desktop) { try { await desktop[NAMES.desktop.method](); focused = true; } catch {} }
+  return { selected, focused };
+}`;
+async function officeInfo(cdp) {
+  return cdp.call(PAGE_OFFICE_INFO);
+}
+async function internalsCheck(cdp) {
+  return cdp.call(PAGE_INTERNALS);
+}
+async function openConversation(cdp, id) {
+  return cdp.call(PAGE_OPEN, id);
+}
